# hot-bag optional config.
# Copy to ~/.config/hot-bag/config and edit. All values are optional;
# anything you don't set uses the built-in default.

# How often the watchdog samples, in seconds.
# INTERVAL=30

# Temperature thresholds (°C) used to label samples OK / WARM / HOT / CRITICAL.
# WARN_C=80
# HOT_C=90
# CRIT_C=95

# Host used for the connectivity ping.
# PING_HOST=1.1.1.1

# Wi-Fi fallback: if the link drops and these are set, the watchdog tries to
# rejoin this hotspot automatically. Leave blank to disable.
# WIFI_SSID="My iPhone"
# WIFI_PASSWORD="hunter2"

# Low-battery safety. 'sleep' = when on battery below LOW_BATT_PCT, let the Mac
# sleep gracefully (state preserved) instead of risking a hard power-off.
# 'none' = just log it. Requires passwordless sudo for pmset to work unattended.
# LOW_BATT_ACTION=none
# LOW_BATT_PCT=7

# Lid-close chime: play an 8-bit sound when you shut the lid mid-run, as a last
# audible "hot-bag is still going" before the Mac goes in the bag. 'on' (default)
# plays a built-in chiptune generated on the fly; 'off' disables it.
# Preview it any time with:  hot-bag chime
# LID_CHIME=on
# Point at your own audio file (anything afplay reads) to override the built-in.
# LID_CHIME_FILE="$HOME/Sounds/my-8bit.wav"
# Playback volume 0.0–1.0 (blank = current system volume).
# LID_CHIME_VOLUME=0.6
# If your Mac is muted, temporarily unmute JUST for the chime and restore your
# exact mute/volume right after (default on). 'off' plays into the mute (silent)
# and never touches your audio settings.
# LID_CHIME_UNMUTE=on
